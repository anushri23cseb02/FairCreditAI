# Keep the Docker build context small and free of secrets.
# data/ and models/ ARE needed: Dockerfile.backend COPYs the committed
# model artifacts and datasets into the image (no host volume on a
# standalone cloud deploy). reports/ is runtime-generated output only.
.git
.gitignore
.env
.env.*
!.env.example
**/__pycache__
**/*.pyc
.pytest_cache
.venv
.venv_check
venv
.vscode
.idea
reports/
tests/
*.zip
*.log
backup*.sql
