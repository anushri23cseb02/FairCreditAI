# =============================================================
# FairCredit AI - Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to Git.
# =============================================================

APP_NAME=FairCredit AI
APP_ENV=development
# false = quiet, readable logs (recommended for any deployment).
# true  = also logs every SQL statement WITH its parameters, which includes applicant
#         input values. Use only while debugging on your own computer.
APP_DEBUG=false

# ---------------------------------------------------------------
# MySQL Database
# ---------------------------------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=faircredit_ai
MYSQL_USER=faircredit_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# Full SQLAlchemy connection string used by the backend.
# Note: host is "mysql" (the docker-compose service name) when running
# inside Docker, and "localhost" when running the backend directly on
# your machine against a locally mapped MySQL port.
DATABASE_URL=mysql+pymysql://faircredit_user:change_me@mysql:3306/faircredit_ai

# ---------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ---------------------------------------------------------------
# Frontend (Streamlit)
# ---------------------------------------------------------------
FRONTEND_PORT=8501

# URL the Streamlit frontend uses to reach the backend.
# Inside Docker Compose: http://backend:8000
# Running locally without Docker: http://localhost:8000
BACKEND_URL=http://backend:8000

# ---------------------------------------------------------------
# ML / Data
# ---------------------------------------------------------------

# ---------------------------------------------------------------
# File upload limits
# ---------------------------------------------------------------
